# ---------- Core API (server/) ----------
NODE_ENV=development
PORT=4000
# Local: mongodb://127.0.0.1:27017/campusconnect   Atlas: mongodb+srv://user:pass@cluster/campusconnect
MONGO_URI=mongodb://127.0.0.1:27017/campusconnect
# At least 16 random characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGIN=http://localhost:5173
# Internal URL of the AI service and the shared token it expects
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=replace-with-a-shared-service-token
AI_TIMEOUT_MS=15000
# Deadline reminder sweep interval
REMINDER_INTERVAL_MINUTES=15
# First admin account, created once when no admin exists. Admins cannot self-register.
ADMIN_SEED_EMAIL=admin@yourcollege.edu
ADMIN_SEED_PASSWORD=change-me-to-a-strong-password

# ---------- AI service (ai-service/) ----------
SERVICE_TOKEN=replace-with-a-shared-service-token
# Optional. Leave empty to use the rule-based extractor (no external calls).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
REFERENCE_YEAR=2026

# ---------- Frontend (client/) ----------
# Leave empty in development (Vite proxies /api). Set to the deployed API URL on Vercel, e.g. https://api.example.com/api
VITE_API_URL=
